{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm install --silent || echo 'no deps to install'",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "github": {
    "silent": true
  },
  "headers": [
    {
      "//": "hariomlohardev.vercel.app serves the same bytes as the canonical github.io site. Left indexable it is a duplicate competing with the original, so every vercel.app host — production and previews — stays out of the index. github.io is unaffected: it is not served by Vercel.",
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/certificates/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/blog/comments",
      "destination": "/api/blog/social?type=comments"
    },
    {
      "source": "/api/blog/comments/",
      "destination": "/api/blog/social?type=comments"
    },
    {
      "source": "/api/blog/ratings",
      "destination": "/api/blog/social?type=ratings"
    },
    {
      "source": "/api/blog/ratings/",
      "destination": "/api/blog/social?type=ratings"
    },
    {
      "source": "/api/admin/login",
      "destination": "/api/admin/auth?action=login"
    },
    {
      "source": "/api/admin/verify",
      "destination": "/api/admin/auth?action=verify"
    },
    {
      "source": "/api/contact",
      "destination": "/api/blog/social?type=contact"
    },
    {
      "source": "/api/contact/",
      "destination": "/api/blog/social?type=contact"
    },
    {
      "source": "/api/tricks",
      "destination": "/api/admin/posts?type=tricks"
    },
    {
      "source": "/api/tricks/",
      "destination": "/api/admin/posts?type=tricks"
    },
    {
      "source": "/tricks/p/:id",
      "destination": "/trick?id=:id"
    },
    {
      "source": "/tricks/p/:id/",
      "destination": "/trick?id=:id"
    },
    {
      "source": "/blog/p/:slug",
      "destination": "/post?slug=:slug"
    },
    {
      "source": "/blog/p/:slug/",
      "destination": "/post?slug=:slug"
    },
    {
      "source": "/projects/p/:slug",
      "destination": "/projects/p/:slug/index.html"
    },
    {
      "source": "/projects/p/:slug/",
      "destination": "/projects/p/:slug/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/tricks.html",
      "destination": "/tricks",
      "permanent": true
    },
    {
      "source": "/projects.html",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/opensource.html",
      "destination": "/opensource",
      "permanent": true
    },
    {
      "source": "/community.html",
      "destination": "/community",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/thanks.html",
      "destination": "/thanks",
      "permanent": true
    },
    {
      "source": "/projects/spam_classifier.html",
      "destination": "/projects/spam_classifier",
      "permanent": true
    },
    {
      "source": "/blog/p/:slug.html",
      "destination": "/blog/p/:slug",
      "permanent": true
    },
    {
      "source": "/post.html",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>.*)"
        }
      ],
      "destination": "/blog/p/:slug",
      "permanent": true
    },
    {
      "source": "/post",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>.*)"
        }
      ],
      "destination": "/blog/p/:slug",
      "permanent": true
    }
  ],
  "crons": []
}
